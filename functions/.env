# Non-secret function parameters.
#
# These are safe to commit: they are public URLs and display names,
# not credentials. Real secrets (Stripe keys, the SendGrid API key)
# live in Google Secret Manager and are declared in lib/config.js:
#
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set SENDGRID_API_KEY
#
# Never put a secret in this file.

SITE_URL=https://the1pnation.com
PORTAL_URL=https://the1p-leadership.web.app
FROM_EMAIL=anthony@the1pnation.com
FROM_NAME=Anthony, The One Percent
REPLY_TO=the1percentnation@gmail.com

# CAN-SPAM requires a real physical postal address in every
# commercial email. Replace this before the first send goes out.
MAILING_ADDRESS=The One Percent Nation, [STREET ADDRESS], [CITY, STATE ZIP]
